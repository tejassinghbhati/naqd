# ---------------------------------------------------------------------------
# Calibra
#
# Everything here has a working default. The only variable you must set to
# trade for real is PRIVATE_KEY, and DRY_RUN protects you until you also
# turn that off deliberately.
# ---------------------------------------------------------------------------

# Which deployment the AGENT trades on: testnet | mainnet
# Analytics always read mainnet history (testnet is too thin to estimate on).
NETWORK=testnet

# Log intended orders instead of sending them. ONLY the exact string "false"
# turns this off, so a typo leaves you safe rather than live.
DRY_RUN=true

# Signer for the agent. Use a dedicated bot wallet holding only what you are
# willing to automate. Never commit this file with a real key in it.
# PRIVATE_KEY=0x...

# Venue scope. Auto-detected from live markets; set it to pin one.
# Venue ids MOVE - both networks changed theirs three times in one week.
# VENUE_ID=0x458b30c2d72bfd2c6317304a4594ecbafe5f729d3111b65fdc3a33bd48e5432d

# --- Edge gate -------------------------------------------------------------
EDGE_WINDOW_DAYS=7      # lookback for the "current regime" estimate
EDGE_MIN_MARKETS=60     # refuse to estimate on fewer resolved markets than this
EDGE_MIN=0.02           # minimum edge (probability points) before quoting

# --- Quoting ---------------------------------------------------------------
QUOTE_SIZE=50           # shares per side at full confidence (mainnet: use ~1)
REQUOTE_SEC=45
MAX_MARKETS=6
MIN_HALF_SPREAD=0.02
MIN_WINDOW_FRACTION=0.15

# --- Infrastructure --------------------------------------------------------
PORT=8787
# CALIBRA_DB=data/calibra-mainnet.db
# RPC_URL=
# INDEXER_URL=
