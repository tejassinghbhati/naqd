{
  "name": "assay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Edge intelligence and market-making agent for DreamDEX event contracts on Somnia",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "backfill": "tsx src/cli/backfill.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "analyze": "tsx src/cli/analyze.ts",
    "api": "tsx src/api/server.ts",
    "web": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "agent": "tsx src/cli/agent.ts",
    "test": "tsx --test src/**/*.test.ts",
    "verify": "tsx src/cli/verify.ts",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@somnia-chain/markets-sdk": "^0.28.0",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}